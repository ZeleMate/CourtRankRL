{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__sonarqube__search_sonar_issues_in_projects",
      "mcp__sonarqube__get_project_quality_gate_status",
      "mcp__sonarqube__list_quality_gates",
      "mcp__sonarqube__search_security_hotspots",
      "mcp__sonarqube__show_security_hotspot",
      "mcp__sonarqube__search_files_by_coverage",
      "mcp__sonarqube__get_file_coverage_details",
      "mcp__sonarqube__get_component_measures",
      "mcp__sonarqube__list_organizations",
      "mcp__sonarqube__search_my_sonarqube_projects",
      "mcp__sonarqube__list_branches",
      "mcp__sonarqube__list_pull_requests",
      "mcp__sonarqube__show_rule",
      "mcp__sonarqube__search_duplicated_files",
      "mcp__sonarqube__get_duplications",
      "mcp__sonarqube__search_dependency_risks"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(cargo publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh release create *)",
      "Bash(gh secret *)",
      "Bash(gh api -X DELETE *)",
      "mcp__sonarqube__change_sonar_issue_status",
      "mcp__sonarqube__change_security_hotspot_status",
      "mcp__sonarqube__toggle_automatic_analysis",
      "mcp__sonarqube__architecture_set",
      "mcp__sonarqube__create_webhook"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
